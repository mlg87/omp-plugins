{
  "name": "omp-jira-link",
  "version": "1.0.0",
  "description": "Shows the Jira issue from your git branch below the composer: a clickable key, live status, and title via omp's Atlassian MCP login.",
  "license": "MIT",
  "omp": {
    "extensions": [
      "./src/jira-link.ts"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@oh-my-pi/pi-coding-agent": "*",
    "@oh-my-pi/pi-tui": "*",
    "bun-types": "^1.3.14"
  },
  "scripts": {
    "lint": "biome check src",
    "format": "biome check --write src",
    "typecheck": "tsc -p .",
    "test": "bun test src"
  }
}
